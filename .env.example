# =============================================================================
# CEUTIA — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# This file contains configuration REFERENCES and SAFE DEFAULTS only.
# NEVER place real secrets, private keys, tokens, passwords, credentials,
# production endpoints, personal data, medical data, intelligence data,
# source credentials or cryptographic material in this file.
#
# Copy to .env for local development:
#     cp .env.example .env
#
# Production secrets MUST be injected through the deployment secret-management
# mechanism and MUST NOT be committed to Git.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

CEUTIA_APP_NAME=ceutia
CEUTIA_ENVIRONMENT=development
CEUTIA_VERSION=0.1.0

# Allowed values:
# development
# testing
# staging
# production
CEUTIA_LOG_LEVEL=INFO

CEUTIA_DEBUG=false
CEUTIA_TESTING=false

# Public API metadata
CEUTIA_API_PREFIX=/api
CEUTIA_API_VERSION=v1

# -----------------------------------------------------------------------------
# SECURITY MODE
# -----------------------------------------------------------------------------

CEUTIA_SECURITY_MODE=development

# Must be explicitly enabled before production deployment.
CEUTIA_PRODUCTION_HARDENING=false

# Prevent accidental startup with development configuration in production.
CEUTIA_REQUIRE_PRODUCTION_CONFIGURATION=true

# -----------------------------------------------------------------------------
# HOST / NETWORK
# -----------------------------------------------------------------------------

CEUTIA_HOST=0.0.0.0
CEUTIA_PORT=8000

# Public-facing canonical origin.
# Example:
# https://api.example.org
CEUTIA_PUBLIC_BASE_URL=http://localhost:8000

# Frontend origin(s).
# Multiple origins may be supplied as a comma-separated list.
CEUTIA_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Never commit a real DATABASE_URL.
#
# Local example only:
# postgresql+psycopg://ceutia:CHANGE_ME@localhost:5432/ceutia

CEUTIA_DATABASE_URL=postgresql+psycopg://ceutia:CHANGE_ME@localhost:5432/ceutia

CEUTIA_DATABASE_POOL_SIZE=10
CEUTIA_DATABASE_MAX_OVERFLOW=20
CEUTIA_DATABASE_POOL_TIMEOUT=30
CEUTIA_DATABASE_POOL_RECYCLE=1800

CEUTIA_DATABASE_SSL_MODE=prefer

# Production should normally use:
# require
# verify-ca
# verify-full
#
# The exact value depends on the deployment topology and certificate
# configuration.


# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------

CEUTIA_REDIS_URL=redis://localhost:6379/0

CEUTIA_REDIS_ENABLED=true

CEUTIA_REDIS_MAX_CONNECTIONS=50


# -----------------------------------------------------------------------------
# MESSAGE BROKER / STREAMING
# -----------------------------------------------------------------------------

CEUTIA_STREAMING_ENABLED=false

CEUTIA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

CEUTIA_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Production examples may use:
# SASL_SSL
#
# Never put SASL usernames/passwords directly into tracked configuration.

CEUTIA_KAFKA_CLIENT_ID=ceutia

CEUTIA_KAFKA_CONSUMER_GROUP=ceutia


# -----------------------------------------------------------------------------
# OBJECT STORAGE
# -----------------------------------------------------------------------------

CEUTIA_OBJECT_STORAGE_ENABLED=false

# S3-compatible endpoint.
# Example:
# https://s3.example.org
CEUTIA_OBJECT_STORAGE_ENDPOINT=

CEUTIA_OBJECT_STORAGE_REGION=

CEUTIA_OBJECT_STORAGE_BUCKET=

CEUTIA_OBJECT_STORAGE_USE_TLS=true


# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------

CEUTIA_AUTHENTICATION_ENABLED=true

# JWT issuer and audience MUST be unique to the deployment.
CEUTIA_JWT_ISSUER=ceutia
CEUTIA_JWT_AUDIENCE=ceutia-api

# Algorithm MUST match the configured key infrastructure.
# Recommended production asymmetric configuration:
# RS256
#
# Do not place private signing keys in this file.
CEUTIA_JWT_ALGORITHM=RS256

CEUTIA_ACCESS_TOKEN_TTL_MINUTES=15
CEUTIA_REFRESH_TOKEN_TTL_HOURS=24

# JWT clock-skew tolerance.
CEUTIA_JWT_LEEWAY_SECONDS=30


# -----------------------------------------------------------------------------
# KEY MANAGEMENT
# -----------------------------------------------------------------------------
# CEUTIA MUST support external key management in production.
#
# Possible implementations:
# - cloud KMS
# - HSM
# - Vault
# - another approved enterprise key-management system
#
# Private keys MUST NEVER be committed to Git.

CEUTIA_KEY_PROVIDER=local-development

# Allowed conceptual values:
# local-development
# vault
# kms
# hsm

CEUTIA_JWKS_URL=

CEUTIA_JWT_PRIVATE_KEY_PATH=
CEUTIA_JWT_PUBLIC_KEY_PATH=

# Key identifiers allow controlled key rotation.
CEUTIA_JWT_KEY_ID=development-key


# -----------------------------------------------------------------------------
# PASSWORD SECURITY
# -----------------------------------------------------------------------------

CEUTIA_PASSWORD_MIN_LENGTH=16

# Passwords MUST be hashed using a memory-hard password hashing algorithm.
CEUTIA_PASSWORD_HASH_ALGORITHM=argon2id

# Never store plaintext passwords.
CEUTIA_PASSWORD_BREACH_CHECK_ENABLED=true

# Production may integrate with an approved breached-password screening
# service without transmitting plaintext passwords.


# -----------------------------------------------------------------------------
# MULTI-FACTOR AUTHENTICATION
# -----------------------------------------------------------------------------

CEUTIA_MFA_ENABLED=true

CEUTIA_MFA_REQUIRED_FOR_OWNER=true
CEUTIA_MFA_REQUIRED_FOR_ADMIN=true

# Supported conceptual methods:
# totp
# webauthn
# passkey
#
# Production should prefer phishing-resistant authentication where feasible.
CEUTIA_MFA_DEFAULT_METHOD=totp


# -----------------------------------------------------------------------------
# AUTHORIZATION
# -----------------------------------------------------------------------------

CEUTIA_AUTHORIZATION_ENABLED=true

# Default-deny authorization.
CEUTIA_AUTHORIZATION_DEFAULT_DENY=true

# Explicit authorization domains.
CEUTIA_PUBLIC_ACCESS_ENABLED=true
CEUTIA_OWNER_ACCESS_ENABLED=true

# Medical/private domains MUST remain disabled until their complete
# authorization, legal and data-protection controls are implemented.
CEUTIA_MEDICAL_ACCESS_ENABLED=false


# -----------------------------------------------------------------------------
# PUBLIC / OWNER DATA ISOLATION
# -----------------------------------------------------------------------------
# These controls define application-level isolation.
# They do NOT constitute a physical air gap.

CEUTIA_PUBLIC_OWNER_ISOLATION_ENABLED=true

CEUTIA_PUBLIC_CAN_READ_OWNER_DATA=false
CEUTIA_PUBLIC_CAN_WRITE_OWNER_DATA=false

CEUTIA_OWNER_CAN_READ_PUBLIC_DATA=true
CEUTIA_OWNER_CAN_WRITE_PUBLIC_DATA=true

CEUTIA_PUBLIC_CAN_READ_PRIVATE_DATA=false
CEUTIA_PUBLIC_CAN_WRITE_PRIVATE_DATA=false


# -----------------------------------------------------------------------------
# DATA CLASSIFICATION
# -----------------------------------------------------------------------------

CEUTIA_DATA_CLASSIFICATION_ENABLED=true

# Default classification for newly created records.
#
# Allowed conceptual values:
# PUBLIC
# INTERNAL
# RESTRICTED
# CONFIDENTIAL
# SENSITIVE
# MEDICAL
#
# The application should never silently downgrade a classification.
CEUTIA_DEFAULT_DATA_CLASSIFICATION=INTERNAL


# -----------------------------------------------------------------------------
# EPISTEMIC INTEGRITY
# -----------------------------------------------------------------------------
# CEUTIA treats information integrity separately from infrastructure
# cybersecurity. These controls protect provenance, evidence lineage,
# corroboration state and epistemic status.

CEUTIA_EPISTEMIC_INTEGRITY_ENABLED=true

CEUTIA_REQUIRE_SOURCE_PROVENANCE=true
CEUTIA_REQUIRE_EVIDENCE_PROVENANCE=true
CEUTIA_REQUIRE_CLAIM_PROVENANCE=true

CEUTIA_ALLOW_UNSOURCED_CLAIMS=false

CEUTIA_ALLOW_UNVERIFIED_EVIDENCE=true

CEUTIA_REQUIRE_INDEPENDENCE_ASSESSMENT=true
CEUTIA_REQUIRE_CONTRADICTION_TRACKING=true
CEUTIA_REQUIRE_UNCERTAINTY_METADATA=true


# -----------------------------------------------------------------------------
# AI / MODEL SAFETY
# -----------------------------------------------------------------------------

CEUTIA_AI_ENABLED=true

CEUTIA_MODEL_REGISTRY_ENABLED=true

CEUTIA_MODEL_PROVENANCE_REQUIRED=true
CEUTIA_MODEL_VERSION_REQUIRED=true

# Prevent automatic deployment of unregistered models.
CEUTIA_ALLOW_UNREGISTERED_MODELS=false

# Prevent autonomous high-impact decisions.
CEUTIA_AUTONOMOUS_HIGH_IMPACT_DECISIONS=false

# Human review required for designated high-impact outputs.
CEUTIA_HUMAN_REVIEW_REQUIRED=true


# -----------------------------------------------------------------------------
# EXTERNAL AI PROVIDERS
# -----------------------------------------------------------------------------
# Provider credentials MUST be supplied through secret management.
# Do not place API keys here.

CEUTIA_EXTERNAL_AI_ENABLED=false

CEUTIA_AI_PROVIDER=

CEUTIA_AI_MODEL=

CEUTIA_AI_API_BASE_URL=

CEUTIA_AI_API_KEY=


# -----------------------------------------------------------------------------
# INGESTION
# -----------------------------------------------------------------------------

CEUTIA_INGESTION_ENABLED=true

CEUTIA_INGESTION_MAX_CONCURRENCY=10

CEUTIA_INGESTION_REQUEST_TIMEOUT_SECONDS=30

CEUTIA_INGESTION_MAX_RETRIES=3

CEUTIA_INGESTION_USER_AGENT=CEUTIA/0.1 (+https://example.org/ceutia)

# Do not bypass robots.txt, access controls, authentication requirements,
# rate limits or applicable terms of service.


# -----------------------------------------------------------------------------
# HTTP CLIENT
# -----------------------------------------------------------------------------

CEUTIA_HTTP_CONNECT_TIMEOUT_SECONDS=10
CEUTIA_HTTP_READ_TIMEOUT_SECONDS=30
CEUTIA_HTTP_WRITE_TIMEOUT_SECONDS=30
CEUTIA_HTTP_POOL_TIMEOUT_SECONDS=10

CEUTIA_HTTP_MAX_CONNECTIONS=100
CEUTIA_HTTP_MAX_KEEPALIVE_CONNECTIONS=20


# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------

CEUTIA_RATE_LIMITING_ENABLED=true

CEUTIA_RATE_LIMIT_REQUESTS=100
CEUTIA_RATE_LIMIT_WINDOW_SECONDS=60

# Authentication endpoints should use substantially stricter limits.
CEUTIA_AUTH_RATE_LIMIT_REQUESTS=10
CEUTIA_AUTH_RATE_LIMIT_WINDOW_SECONDS=60


# -----------------------------------------------------------------------------
# INPUT / OUTPUT SECURITY
# -----------------------------------------------------------------------------

CEUTIA_INPUT_VALIDATION_ENABLED=true
CEUTIA_OUTPUT_FILTERING_ENABLED=true

CEUTIA_MAX_REQUEST_BODY_MB=10
CEUTIA_MAX_TEXT_LENGTH=1000000

# Reject unexpected fields where schemas define strict contracts.
CEUTIA_REJECT_UNKNOWN_FIELDS=true


# -----------------------------------------------------------------------------
# SECURITY HEADERS
# -----------------------------------------------------------------------------

CEUTIA_SECURITY_HEADERS_ENABLED=true

CEUTIA_HSTS_ENABLED=false

# Enable HSTS only when the deployment is exclusively served over HTTPS
# and the operational consequences of HSTS are understood.
#
# Production HTTPS deployments should normally enable HSTS.

CEUTIA_CONTENT_SECURITY_POLICY_ENABLED=true
CEUTIA_FRAME_ANCESTOR_POLICY_ENABLED=true
CEUTIA_REFERRER_POLICY_ENABLED=true


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

CEUTIA_CORS_ENABLED=true

# Never use "*" with credentialed requests.
CEUTIA_CORS_ALLOW_CREDENTIALS=true

CEUTIA_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

CEUTIA_CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,Origin


# -----------------------------------------------------------------------------
# CSRF
# -----------------------------------------------------------------------------

CEUTIA_CSRF_PROTECTION_ENABLED=true


# -----------------------------------------------------------------------------
# AUDIT LOGGING
# -----------------------------------------------------------------------------

CEUTIA_AUDIT_LOGGING_ENABLED=true

CEUTIA_AUDIT_LOG_AUTHENTICATION=true
CEUTIA_AUDIT_LOG_AUTHORIZATION=true
CEUTIA_AUDIT_LOG_ADMIN_ACTIONS=true
CEUTIA_AUDIT_LOG_DATA_ACCESS=true
CEUTIA_AUDIT_LOG_CONFIGURATION_CHANGES=true
CEUTIA_AUDIT_LOG_SECURITY_EVENTS=true
CEUTIA_AUDIT_LOG_MODEL_EVENTS=true

# Never log:
# - passwords
# - access tokens
# - refresh tokens
# - private keys
# - API keys
# - complete medical records
# - unnecessary personal data
# - session secrets


# -----------------------------------------------------------------------------
# SECURITY EVENT PIPELINE
# -----------------------------------------------------------------------------

CEUTIA_SECURITY_EVENTS_ENABLED=true

CEUTIA_SECURITY_EVENT_RETENTION_DAYS=365

CEUTIA_SECURITY_ALERTING_ENABLED=true


# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------

CEUTIA_METRICS_ENABLED=true
CEUTIA_TRACING_ENABLED=false

CEUTIA_PROMETHEUS_ENABLED=false

CEUTIA_OTEL_ENABLED=false
CEUTIA_OTEL_ENDPOINT=


# -----------------------------------------------------------------------------
# STRUCTURED LOGGING
# -----------------------------------------------------------------------------

CEUTIA_STRUCTURED_LOGGING=true

CEUTIA_LOG_FORMAT=json

CEUTIA_LOG_INCLUDE_TIMESTAMP=true

CEUTIA_LOG_INCLUDE_REQUEST_ID=true

CEUTIA_LOG_INCLUDE_TRACE_ID=true


# -----------------------------------------------------------------------------
# REQUEST CORRELATION
# -----------------------------------------------------------------------------

CEUTIA_REQUEST_ID_HEADER=X-Request-ID

CEUTIA_TRACE_ID_HEADER=X-Trace-ID


# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------

CEUTIA_FILE_UPLOADS_ENABLED=true

CEUTIA_MAX_UPLOAD_MB=50

CEUTIA_ALLOWED_UPLOAD_TYPES=application/pdf,text/plain,text/csv,application/json

# Uploaded files MUST be treated as untrusted input.
CEUTIA_UPLOAD_MALWARE_SCANNING_ENABLED=false


# -----------------------------------------------------------------------------
# BACKUPS
# -----------------------------------------------------------------------------

CEUTIA_BACKUPS_ENABLED=false

CEUTIA_BACKUP_ENCRYPTION_REQUIRED=true

CEUTIA_BACKUP_RETENTION_DAYS=30

# Backup destination must be external to the primary application environment.
CEUTIA_BACKUP_STORAGE_URI=


# -----------------------------------------------------------------------------
# DISASTER RECOVERY
# -----------------------------------------------------------------------------

CEUTIA_DISASTER_RECOVERY_ENABLED=false

CEUTIA_RECOVERY_POINT_OBJECTIVE_MINUTES=60
CEUTIA_RECOVERY_TIME_OBJECTIVE_MINUTES=240


# -----------------------------------------------------------------------------
# INCIDENT RESPONSE
# -----------------------------------------------------------------------------

CEUTIA_INCIDENT_RESPONSE_ENABLED=true

CEUTIA_INCIDENT_AUTO_CONTAINMENT=false

# Automatic containment may be enabled only for explicitly defined,
# tested and reversible controls.
CEUTIA_INCIDENT_REQUIRE_HUMAN_APPROVAL=true


# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------

CEUTIA_FEATURE_EARLY_WARNING=true
CEUTIA_FEATURE_HYPOTHESES=true
CEUTIA_FEATURE_CONTRADICTION_ENGINE=true
CEUTIA_FEATURE_PROVENANCE_GRAPH=true
CEUTIA_FEATURE_NETWORK_ANALYSIS=true
CEUTIA_FEATURE_ANOMALY_DETECTION=true
CEUTIA_FEATURE_SCENARIO_ENGINE=false
CEUTIA_FEATURE_AUTOMATED_ALERTING=true


# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY
# -----------------------------------------------------------------------------

CEUTIA_DEV_SEED_DATABASE=false
CEUTIA_DEV_ENABLE_DOCS=true
CEUTIA_DEV_ENABLE_OPENAPI=true

# Never enable these options in production.
CEUTIA_DEV_ALLOW_INSECURE_HTTP=true
CEUTIA_DEV_ALLOW_TEST_USERS=false


# -----------------------------------------------------------------------------
# TESTING
# -----------------------------------------------------------------------------

CEUTIA_TEST_DATABASE_URL=postgresql+psycopg://ceutia_test:CHANGE_ME@localhost:5432/ceutia_test

CEUTIA_TEST_DISABLE_EXTERNAL_SERVICES=true

CEUTIA_TEST_DISABLE_REAL_EMAIL=true
CEUTIA_TEST_DISABLE_REAL_NOTIFICATIONS=true
CEUTIA_TEST_DISABLE_REAL_AI_REQUESTS=true


# -----------------------------------------------------------------------------
# EMAIL / NOTIFICATIONS
# -----------------------------------------------------------------------------
# Credentials MUST be supplied through secret management.

CEUTIA_NOTIFICATIONS_ENABLED=false

CEUTIA_EMAIL_ENABLED=false

CEUTIA_SMTP_HOST=
CEUTIA_SMTP_PORT=587
CEUTIA_SMTP_USERNAME=
CEUTIA_SMTP_PASSWORD=

CEUTIA_EMAIL_FROM=


# -----------------------------------------------------------------------------
# WEBHOOKS
# -----------------------------------------------------------------------------

CEUTIA_WEBHOOKS_ENABLED=false

CEUTIA_WEBHOOK_SIGNING_SECRET=

# Webhook receivers MUST validate signatures before processing payloads.


# -----------------------------------------------------------------------------
# SECRET MANAGEMENT
# -----------------------------------------------------------------------------

CEUTIA_SECRET_MANAGER_ENABLED=false

CEUTIA_SECRET_MANAGER_PROVIDER=

# Conceptual values:
# vault
# aws-secrets-manager
# gcp-secret-manager
# azure-key-vault
# kubernetes-secrets
# hsm
# kms

CEUTIA_SECRET_MANAGER_NAMESPACE=


# -----------------------------------------------------------------------------
# DEPLOYMENT IDENTITY
# -----------------------------------------------------------------------------

CEUTIA_DEPLOYMENT_ID=local-development

# Unique identifier for the running deployment/environment.
# This MUST NOT contain personal data.


# -----------------------------------------------------------------------------
# SECURITY SCANNING
# -----------------------------------------------------------------------------

CEUTIA_SECURITY_SCANNING_ENABLED=true

CEUTIA_DEPENDENCY_SCANNING_ENABLED=true
CEUTIA_SECRET_SCANNING_ENABLED=true
CEUTIA_CONTAINER_SCANNING_ENABLED=true
CEUTIA_SAST_ENABLED=true
CEUTIA_DAST_ENABLED=false


# -----------------------------------------------------------------------------
# SUPPLY CHAIN
# -----------------------------------------------------------------------------

CEUTIA_REQUIRE_LOCKFILE=true
CEUTIA_REQUIRE_DEPENDENCY_HASHES=false
CEUTIA_REQUIRE_SBOM=false

# Production release policy should progressively enable:
# - reproducible builds
# - dependency pinning
# - vulnerability scanning
# - SBOM generation
# - artifact signing
# - provenance attestations
# - trusted build pipelines


# -----------------------------------------------------------------------------
# DATA RETENTION
# -----------------------------------------------------------------------------

CEUTIA_DATA_RETENTION_ENABLED=true

CEUTIA_RAW_DATA_RETENTION_DAYS=3650
CEUTIA_DERIVED_DATA_RETENTION_DAYS=3650
CEUTIA_AUDIT_RETENTION_DAYS=3650
CEUTIA_SECURITY_EVENT_RETENTION_DAYS=365

# Retention periods MUST ultimately be determined by legal, operational,
# evidentiary and governance requirements.


# -----------------------------------------------------------------------------
# PRIVACY
# -----------------------------------------------------------------------------

CEUTIA_PRIVACY_CONTROLS_ENABLED=true

CEUTIA_DATA_MINIMIZATION_ENABLED=true

CEUTIA_PURPOSE_LIMITATION_ENABLED=true

CEUTIA_PERSONAL_DATA_ACCESS_LOGGING=true

CEUTIA_SPECIAL_CATEGORY_DATA_ENABLED=false


# -----------------------------------------------------------------------------
# GEOGRAPHIC / JURISDICTIONAL CONFIGURATION
# -----------------------------------------------------------------------------

CEUTIA_PRIMARY_JURISDICTION=ES

CEUTIA_PRIMARY_REGION=EU

CEUTIA_TIMEZONE=Europe/Madrid

# Geographic restrictions, where required, MUST be treated as an additional
# control and MUST NOT replace authentication or authorization.


# -----------------------------------------------------------------------------
# SAFETY INVARIANTS
# -----------------------------------------------------------------------------
# These values express security properties that application code should
# enforce rather than treating as optional preferences.

CEUTIA_INVARIANT_DEFAULT_DENY=true
CEUTIA_INVARIANT_NO_SECRET_LOGGING=true
CEUTIA_INVARIANT_NO_PUBLIC_OWNER_CROSSOVER=true
CEUTIA_INVARIANT_NO_UNAUTHENTICATED_OWNER_ACCESS=true
CEUTIA_INVARIANT_NO_UNREGISTERED_MODEL_EXECUTION=true
CEUTIA_INVARIANT_REQUIRE_PROVENANCE=true
CEUTIA_INVARIANT_REQUIRE_AUDIT_TRAIL=true
CEUTIA_INVARIANT_REQUIRE_HUMAN_OVERSIGHT_HIGH_IMPACT=true


# -----------------------------------------------------------------------------
# CONFIGURATION INTEGRITY
# -----------------------------------------------------------------------------

CEUTIA_CONFIGURATION_VERSION=1

# Configuration changes should be version-controlled through deployment
# mechanisms and independently auditable.

CEUTIA_CONFIGURATION_CHANGE_REQUIRES_REVIEW=true


# =============================================================================
# END OF FILE
# =============================================================================