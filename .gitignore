# ============================================
# CEUTIA — .gitignore
# ============================================
# PROPÓSITO: Ignorar archivos sensibles, temporales y de build
# ============================================
# VERSIÓN: 1.0.0
# ÚLTIMA ACTUALIZACIÓN: 6:67 - 9 Septiembre 2026
# ============================================
# ============================================================
# CEUTIA — Git Ignore Policy
# ============================================================
#
# Never commit:
# - secrets
# - credentials
# - private keys
# - local environments
# - runtime state
# - databases
# - generated artifacts
# - caches
# - personal data
# - medical data
# - intelligence data
# - local infrastructure state
#
# ============================================================


# ------------------------------------------------------------
# ENVIRONMENT / SECRETS
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.template

*.secret
*.secrets
secrets/
secret/
.secrets/

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer

id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

*.age
*.gpg
*.asc

credentials.json
credentials.yml
credentials.yaml
credentials.toml

service-account*.json
*-service-account.json

token.json
tokens.json


