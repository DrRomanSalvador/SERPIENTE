# ============================================
# CEUTIA — .gitignore
# ============================================
# PROPÓSITO: Ignorar archivos sensibles, temporales y de build
# ============================================
# VERSIÓN: 2.0.0
# ÚLTIMA ACTUALIZACIÓN: Septiembre 2026
# ============================================

# ============================================
# SECRETOS Y CONFIGURACIÓN (CRÍTICO)
# ============================================

# Variables de entorno (NUNCA subir secretos)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.envrc
.env.backup

# Configuración con secretos
config/.env
config/.env.*
config/secrets/
config/credentials/
secrets/
credentials/
*.secret
*.secrets

# Certificados y claves privadas
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.truststore
ssl/
certs/
private/

# Tokens y API keys
*.token
*.tokens
*.apikey
*.api_key
*.access_token
*.refresh_token

