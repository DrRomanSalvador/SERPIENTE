# ============================================
# CEUTIA — Environment Configuration
# ============================================
# PROPÓSITO: Configuración completa del sistema CEUTIA
# ============================================
# INSTRUCCIONES:
# 1. Copia este archivo a .env
# 2. Reemplaza TODOS los valores de CHANGE_THIS_*
# 3. NUNCA subas .env con valores reales a GitHub
# 4. Usa valores diferentes en desarrollo y producción
# ============================================
# VERSIÓN: 2.0.0
# ÚLTIMA ACTUALIZACIÓN: Septiembre 2026
# ============================================

# ============================================
# ENTORNO Y PUERTOS
# ============================================

# Entorno de ejecución
# Opciones: development, staging, production
NODE_ENV=development

# Puerto del servidor API
PORT=3000

# Puerto del frontend público
FRONTEND_PORT=3001

# Puerto del frontend Owner
OWNER_PORT=3002

# Puerto del frontend médico
MEDICAL_PORT=3003

# Host del servidor
HOST=0.0.0.0

# ============================================
# BASE DE DATOS (PostgreSQL + pgvector)
# ============================================

# Conexión básica
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ceutia
DATABASE_USER=ceutia_user
DATABASE_PASSWORD=CHANGE_THIS_PASSWORD_STRONG_MIN_32_CHARS

# Connection string completa (alternativa a las variables individuales)
DATABASE_URL=postgresql://ceutia_user:CHANGE_THIS_PASSWORD_STRONG_MIN_32_CHARS@localhost:5432/ceutia

# Pool de conexiones
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_ACQUIRE_TIMEOUT=30000
DATABASE_POOL_CREATE_TIMEOUT=30000
DATABASE_POOL_CREATE_RETRY_INTERVAL=1000
DATABASE_POOL_CREATE_RETRIES=3

# SSL (producción)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA=
DATABASE_SSL_CERT=
DATABASE_SSL_KEY=

# Réplicas (producción - opcional)
DATABASE_READ_REPLICA_HOST=
DATABASE_READ_REPLICA_PORT=5432

# ============================================
# OBJECT STORAGE (Documentos y Archivos)
# ============================================

# Proveedor de storage
# Opciones: local, s3, gcs, azure, minio
STORAGE_PROVIDER=local

# ============================================
# STORAGE LOCAL (desarrollo)
# ============================================
STORAGE_LOCAL_PATH=./storage/documents
STORAGE_LOCAL_MAX_SIZE=104857600
# 100MB por defecto

# ============================================
# AWS S3 (producción)
# ============================================
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=ceutia-documents
STORAGE_REGION=eu-west-1
STORAGE_USE_SSL=true
STORAGE_PATH_STYLE=false
# true para MinIO, false para S3

# ============================================
# GOOGLE CLOUD STORAGE
# ============================================
STORAGE_GCS_PROJECT_ID=
STORAGE_GCS_KEY_FILE=
STORAGE_GCS_BUCKET=

# ============================================
# AZURE BLOB STORAGE
# ============================================
STORAGE_AZURE_ACCOUNT_NAME=
STORAGE_AZURE_ACCOUNT_KEY=
STORAGE_AZURE_CONTAINER=

# ============================================
# AUTENTICACIÓN Y SEGURIDAD
# ============================================

# JWT (JSON Web Tokens)
JWT_SECRET=CHANGE_THIS_JWT_SECRET_MIN_64_CHARS_USE_CRYPTO_RANDOM
JWT_ALGORITHM=HS256
# Opciones: HS256, HS384, HS512, RS256, RS384, RS512

JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=ceutia.system
JWT_AUDIENCE=ceutia.clients

# Sesiones
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_MIN_64_CHARS_USE_CRYPTO_RANDOM
SESSION_MAX_AGE=86400000
# 24 horas en milisegundos

SESSION_COOKIE_NAME=ceutia_session
SESSION_COOKIE_SECURE=false
# true en producción (HTTPS)

SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=strict
# Opciones: strict, lax, none

# Hashing de contraseñas
BCRYPT_ROUNDS=12
# 12 es seguro y razonable. 14+ es más lento.

# Rate limiting
SECURITY_RATE_LIMIT=100
# Número máximo de requests

SECURITY_RATE_LIMIT_WINDOW=60000
# Ventana de tiempo en milisegundos (60000 = 1 minuto)

SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION=900000
# 15 minutos en milisegundos

# CORS (Cross-Origin Resource Sharing)
CORS_ORIGIN=http://localhost:3001
# Múltiples orígenes: http://localhost:3001,http://localhost:3002

CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Length,X-Request-Id
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Helmet (security headers)
HELMET_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000
HELMET_CONTENT_SECURITY_POLICY=default-src 'self'

# ============================================
# IA / MODELOS DE LENGUAJE
# ============================================

# Proveedor de IA
# Opciones: openai, anthropic, google, azure, local, ollama
AI_PROVIDER=openai

# ============================================
# OPENAI
# ============================================
AI_API_KEY=CHANGE_THIS_OPENAI_API_KEY
AI_ORGANIZATION=
AI_PROJECT=

AI_MODEL=gpt-4
# Opciones: gpt-4, gpt-4-turbo, gpt-3.5-turbo, etc.

AI_MODEL_EMBEDDING=text-embedding-ada-002
# Para embeddings vectoriales

AI_MODEL_MAX_TOKENS=8192
AI_TEMPERATURE=0.7
# 0 = determinista, 1 = creativo

AI_TOP_P=1
AI_FREQUENCY_PENALTY=0
AI_PRESENCE_PENALTY=0

AI_MAX_TOKENS=2000
AI_TIMEOUT=30000
# 30 segundos

AI_MAX_RETRIES=3
AI_RETRY_DELAY=1000
# 1 segundo entre retries

# ============================================
# ANTHROPIC (alternativa)
# ============================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# ============================================
# GOOGLE (alternativa)
# ============================================
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-pro
GOOGLE_MAX_TOKENS=2048

# ============================================
# LOCAL / OLLAMA (alternativa)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ============================================
# RAG / VECTORES / EMBEDDINGS
# ============================================

# Proveedor de vector store
# Opciones: postgres (pgvector), pinecone, weaviate, qdrant, milvus, chroma
VECTOR_STORE_PROVIDER=postgres

# ============================================
# POSTGRES (pgvector)
# ============================================
VECTOR_POSTGRES_HOST=localhost
VECTOR_POSTGRES_PORT=5432
VECTOR_POSTGRES_DATABASE=ceutia
VECTOR_POSTGRES_USER=ceutia_user
VECTOR_POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_STRONG_MIN_32_CHARS

# Dimensiones del embedding
VECTOR_DIMENSION=1536
# 1536 para ada-002, 3072 para otros modelos

# Índice HNSW
VECTOR_INDEX_TYPE=hnsw
# Opciones: hnsw, ivfflat

VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCTION=64

# ============================================
# PINECONE (alternativa)
# ============================================
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=ceutia
PINECONE_NAMESPACE=

# ============================================
# WEAVIATE (alternativa)
# ============================================
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_SCHEME=http
WEAVIATE_API_KEY=

# ============================================
# QDRANT (alternativa)
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=ceutia
QDRANT_API_KEY=

# ============================================
# CONFIGURACIÓN RAG
# ============================================
RAG_TOP_K=10
# Número de resultados a retornar

RAG_SIMILARITY_THRESHOLD=0.7
# Umbral de similitud coseno (0-1)

RAG_MAX_CONTEXT_TOKENS=4000
# Máximo tokens para contexto

RAG_CHUNK_SIZE=500
# Tamaño de chunks para embeddings

RAG_CHUNK_OVERLAP=50
# Overlap entre chunks

RAG_STRATEGY=hybrid
# Opciones: semantic, keyword, hybrid

# ============================================
# LOGS
# ============================================

# Nivel de log
# Opciones: error, warn, info, http, verbose, debug, trace, silly
LOG_LEVEL=info

# Archivo de log
LOG_FILE=logs/app.log

# Rotación de logs
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=10
LOG_COMPRESS=true

# Formato de log
# Opciones: json, pretty, simple
LOG_FORMAT=json

# Logs separados por componente
LOG_AI_ENABLED=true
LOG_AI_FILE=logs/ai.log

LOG_RAG_ENABLED=true
LOG_RAG_FILE=logs/rag.log

LOG_DB_ENABLED=false
# true puede ser muy verboso

LOG_DB_FILE=logs/db.log

LOG_AUDIT_ENABLED=true
LOG_AUDIT_FILE=logs/audit.log

# ============================================
# ALERTAS Y NOTIFICACIONES
# ============================================

# Alertas habilitadas
ALERTS_ENABLED=true

# ============================================
# EMAIL (SMTP)
# ============================================
ALERTS_EMAIL_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# true para puerto 465

SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CEUTIA Alerts <alerts@ceutia.system>

ALERTS_EMAIL_TO=owner@ceutia.system
ALERTS_EMAIL_CC=
ALERTS_EMAIL_BCC=

# Niveles de alerta que envían email
ALERTS_EMAIL_LEVELS=WARNING,DANGER,CRITICAL

# ============================================
# TELEGRAM
# ============================================
ALERTS_TELEGRAM_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
# Para grupos con topics

# Niveles de alerta que envían a Telegram
ALERTS_TELEGRAM_LEVELS=ATTENTION,WARNING,DANGER,CRITICAL

# ============================================
# SLACK
# ============================================
ALERTS_SLACK_ENABLED=false

SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#ceutia-alerts
SLACK_USERNAME=CEUTIA Bot
SLACK_ICON_EMOJI=:robot_face:

ALERTS_SLACK_LEVELS=WARNING,DANGER,CRITICAL

# ============================================
# PAGERDUTY (producción crítica)
# ============================================
ALERTS_PAGERDUTY_ENABLED=false

PAGERDUTY_SERVICE_KEY=
PAGERDUTY_SEVERITY_MAPPING=true

ALERTS_PAGERDUTY_LEVELS=DANGER,CRITICAL

# ============================================
# AUDITORÍA
# ============================================
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365
AUDIT_LOG_FILE=logs/audit.log
AUDIT_LOG_FORMAT=json

# Eventos a auditar
AUDIT_EVENTS=CREATE,READ,UPDATE,DELETE,EXPORT,IMPORT,LOGIN,LOGOUT,PERMISSION_CHANGE,SECURITY_EVENT,SYSTEM_EVENT,DATA_ACCESS,ALERT_TRIGGERED,MODEL_INFERENCE,RAG_QUERY,EXTERNAL_API_CALL

# ============================================
# URLs PÚBLICAS
# ============================================
PUBLIC_URL=http://localhost:3001
OWNER_URL=http://localhost:3002
API_URL=http://localhost:3000
MEDICAL_URL=http://localhost:3003

# Dominio base (producción)
BASE_DOMAIN=ceutia.system

# ============================================
# MÓDULO MÉDICO
# ============================================
MEDICAL_MODULE_ENABLED=false

# API key para módulo médico
MEDICAL_API_KEY=CHANGE_THIS_MEDICAL_API_KEY_MIN_64_CHARS

# Encriptación de datos médicos
MEDICAL_ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY_32_CHARS_MIN
MEDICAL_ENCRYPTION_ALGORITHM=aes-256-gcm

# Retención de datos médicos (7 años por ley)
MEDICAL_DATA_RETENTION_DAYS=2555

# HIPAA/GDPR compliance
MEDICAL_HIPAA_COMPLIANT=true
MEDICAL_GDPR_COMPLIANT=true

# ============================================
# MONITORING Y MÉTRICAS
# ============================================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
METRICS_PREFIX=ceutia_

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_DETAILED=false

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PUSHGATEWAY_URL=

# ============================================
# CACHE (Redis)
# ============================================
REDIS_ENABLED=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ceutia:

# TLS para Redis (producción)
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true

# ============================================
# QUEUE (Trabajos en Segundo Plano)
# ============================================
QUEUE_PROVIDER=bull
# Opciones: bull (Redis), database, sqs, google-pubsub

# Bull (Redis-based)
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF=1000
QUEUE_REMOVE_ON_COMPLETE=100
QUEUE_REMOVE_ON_FAIL=1000

# ============================================
# INGESTIÓN DE FUENTES
# ============================================
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=15
INGESTION_MAX_CONCURRENT=5
INGESTION_TIMEOUT=30000

# Web scraping
SCRAPER_USER_AGENT=CEUTIA-Bot/2.0 (+https://ceutia.system/bot)
SCRAPER_TIMEOUT=10000
SCRAPER_MAX_REDIRECTS=5
SCRAPER_FOLLOW_REDIRECTS=true
SCRAPER_IGNORE_ROBOTS_TXT=false
# true para respetar robots.txt

# RSS feeds
RSS_POLL_INTERVAL_MINUTES=30

# APIs externas
EXTERNAL_API_TIMEOUT=10000
EXTERNAL_API_MAX_RETRIES=3

# ============================================
# BACKUPS
# ============================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# Backup de base de datos
BACKUP_DB_ENABLED=true
BACKUP_DB_COMMAND=pg_dump
BACKUP_DB_OPTIONS=--format=custom --compress=9

# Backup de storage
BACKUP_STORAGE_ENABLED=true

# Backup remoto (S3)
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_BUCKET=ceutia-backups
BACKUP_REMOTE_PATH=backups/

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_RESPONSES=true
FEATURE_RAG_ENABLED=true
FEATURE_ALERTS_AUTO=true
FEATURE_MEDICAL_MODULE=false
FEATURE_OWNER_RADAR=true
FEATURE_PUBLIC_WEB=true
FEATURE_ANALYTICS=true
FEATURE_DASHBOARD=true

# ============================================
# DESARROLLO Y DEBUG
# ============================================
DEBUG=false
DEBUG_SQL=false
DEBUG_AI=false
DEBUG_RAG=false
DEBUG_AUTH=false
DEBUG_QUEUE=false

# ============================================
# PRODUCCIÓN (cambiar en producción)
# ============================================
# Descomentar y ajustar para producción:

# NODE_ENV=production
# LOG_LEVEL=warn
# DEBUG=false
# CORS_ORIGIN=https://ceutia.system
# SESSION_COOKIE_SECURE=true
# DATABASE_SSL=true
# STORAGE_PROVIDER=s3
# METRICS_ENABLED=true
# AUDIT_ENABLED=true
# BACKUP_ENABLED=true
# ============================================

# ============================================
# VARIABLES ADICIONALES (personalizar)
# ============================================

# Timezone
TZ=Europe/Madrid

# Locale
LOCALE=es-ES

# ============================================
# FIN DE CONFIGURACIÓN
# ============================================
# Si llegaste hasta aquí, ¡bien hecho!
# Ahora copia este archivo a .env y configura todo.
# ============================================
