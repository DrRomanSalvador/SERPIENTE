# ============================================
# CEUTIA — Environment Configuration
# ============================================
# Copia este archivo a .env y reemplaza los valores
# NUNCA subas .env con valores reales a GitHub
# ============================================

# ============================================
# ENTORNO
# ============================================
NODE_ENV=development
PORT=3000
FRONTEND_PORT=3001

# ============================================
# BASE DE DATOS (PostgreSQL + pgvector)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ceutia
DATABASE_USER=ceutia_user
DATABASE_PASSWORD=CHANGE_THIS_PASSWORD_STRONG
DATABASE_URL=postgresql://ceutia_user:CHANGE_THIS_PASSWORD_STRONG@localhost:5432/ceutia

# Pool de conexiones
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_ACQUIRE_TIMEOUT=30000

# ============================================
# OBJECT STORAGE (Documentos)
# ============================================
STORAGE_PROVIDER=local
# Opciones: local, s3, gcs, azure

# Local
STORAGE_LOCAL_PATH=./storage/documents

# S3 (si usas AWS o compatible)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=ceutia-documents
STORAGE_REGION=eu-west-1
STORAGE_USE_SSL=true

# ============================================
# AUTENTICACIÓN Y SEGURIDAD
# ============================================
JWT_SECRET=CHANGE_THIS_JWT_SECRET_MIN_64_CHARS_RANDOM
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_MIN_64_CHARS_RANDOM
SESSION_MAX_AGE=86400000

BCRYPT_ROUNDS=12

# Rate limiting
SECURITY_RATE_LIMIT=100
SECURITY_RATE_LIMIT_WINDOW=60000
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION=900000

# CORS
CORS_ORIGIN=http://localhost:3001
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true

# ============================================
# IA / MODELOS
# ============================================
AI_PROVIDER=openai
# Opciones: openai, anthropic, google, local

AI_API_KEY=CHANGE_THIS_AI_API_KEY
AI_MODEL=gpt-4
AI_MODEL_EMBEDDING=text-embedding-ada-002
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_TIMEOUT=30000
AI_MAX_RETRIES=3

# ============================================
# RAG / VECTORES
# ============================================
VECTOR_STORE_PROVIDER=postgres
# Opciones: postgres (pgvector), pinecone, weaviate, qdrant

VECTOR_DIMENSION=1536
# 1536 para ada-002, 3072 para otros modelos

RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CONTEXT_TOKENS=4000

# ============================================
# LOGS
# ============================================
LOG_LEVEL=info
# Opciones: error, warn, info, debug, trace

LOG_FILE=logs/app.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=10
LOG_FORMAT=json
# Opciones: json, pretty

# ============================================
# ALERTAS Y NOTIFICACIONES
# ============================================
ALERTS_ENABLED=true
ALERTS_EMAIL_ENABLED=false
ALERTS_TELEGRAM_ENABLED=false
ALERTS_SLACK_ENABLED=false

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERTS_EMAIL_TO=owner@ceutia.system

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack
SLACK_WEBHOOK_URL=

# ============================================
# AUDITORÍA
# ============================================
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365
AUDIT_LOG_FILE=logs/audit.log

# ============================================
# URLs PÚBLICAS
# ============================================
PUBLIC_URL=http://localhost:3001
OWNER_URL=http://localhost:3002
API_URL=http://localhost:3000
MEDICAL_URL=http://localhost:3003

# ============================================
# MÓDULO MÉDICO
# ============================================
MEDICAL_MODULE_ENABLED=false
MEDICAL_API_KEY=CHANGE_THIS_MEDICAL_API_KEY
MEDICAL_ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY_32_CHARS

# HIPAA/GDPR compliance
MEDICAL_DATA_RETENTION_DAYS=2555
# 7 años por ley

# ============================================
# MONITORING Y MÉTRICAS
# ============================================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ============================================
# CACHE (Redis)
# ============================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# QUEUE (trabajos en segundo plano)
# ============================================
QUEUE_PROVIDER=bull
# Opciones: bull (Redis), database, sqs

QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF=1000

# ============================================
# INGESTIÓN DE FUENTES
# ============================================
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=15
INGESTION_MAX_CONCURRENT=5
INGESTION_TIMEOUT=30000

# Web scraping
SCRAPER_USER_AGENT=CEUTIA-Bot/2.0 (+https://ceutia.system/bot)
SCRAPER_TIMEOUT=10000
SCRAPER_MAX_REDIRECTS=5

# ============================================
# BACKUPS
# ============================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_RESPONSES=true
FEATURE_RAG_ENABLED=true
FEATURE_ALERTS_AUTO=true
FEATURE_MEDICAL_MODULE=false
FEATURE_OWNER_RADAR=true
FEATURE_PUBLIC_WEB=true

# ============================================
# DESARROLLO
# ============================================
DEBUG=false
DEBUG_SQL=false
DEBUG_AI=false
DEBUG_RAG=false

# ============================================
# PRODUCCIÓN (cambiar en producción)
# ============================================
# NODE_ENV=production
# LOG_LEVEL=warn
# DEBUG=false
# CORS_ORIGIN=https://ceutia.system
# ============================================
