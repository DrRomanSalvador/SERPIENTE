-- ============================================
-- VISTAS ÚTILES (opcional)
-- ============================================

-- Vista: Claims con conteo de evidencias
CREATE VIEW claims_with_evidence_count AS
SELECT 
    c.*,
    COUNT(CASE WHEN ce.relationship_type = 'supports' THEN 1 END) as supporting_count,
    COUNT(CASE WHEN ce.relationship_type = 'contradicts' THEN 1 END) as contradicting_count,
    COUNT(CASE WHEN ce.relationship_type = 'corroborates' THEN 1 END) as corroborating_count
FROM claims c
LEFT JOIN claim_evidence ce ON c.id = ce.claim_id
GROUP BY c.id;

-- Vista: Hipótesis con evaluación resumida
CREATE VIEW hypotheses_summary AS
SELECT 
    h.*,
    p.name as phenomenon_name,
    p.domain as phenomenon_domain,
    COUNT(CASE WHEN he.polarity = 'SUPPORTING' THEN 1 END) as supporting_evidence_count,
    COUNT(CASE WHEN he.polarity = 'OPPOSING' THEN 1 END) as opposing_evidence_count,
    COUNT(CASE WHEN he.polarity = 'FALSIFYING' THEN 1 END) as falsifying_evidence_count
FROM hypotheses h
LEFT JOIN phenomena p ON h.phenomenon_id = p.id
LEFT JOIN hypothesis_evidence he ON h.id = he.hypothesis_id
GROUP BY h.id, p.name, p.domain;

