    sources_used UUID[],
    claims_generated UUID[],
    system_version VARCHAR(50),
    model_version VARCHAR(50),
    prompt_version VARCHAR(50),
    retrieval_version VARCHAR(50),
    output_policy_applied VARCHAR(50),
